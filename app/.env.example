# Скопировать в .env и вставить свой ключ (openrouter.ai → Keys → Create Key).
# Ключ секретный: .env в git не попадает.
VITE_OPENROUTER_API_KEY=
# openrouter/free — роутер: сам выбирает свободную модель из бесплатных.
# Можно указать конкретную, например google/gemma-4-31b-it:free
VITE_LLM_MODEL=openrouter/free
